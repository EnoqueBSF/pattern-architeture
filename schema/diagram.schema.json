{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 400
    },
    "direction": {
      "default": "LR",
      "type": "string",
      "enum": [
        "LR",
        "TB"
      ]
    },
    "locale": {
      "default": "pt-BR",
      "type": "string",
      "enum": [
        "pt-BR",
        "en"
      ]
    },
    "groups": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "kind": {
            "default": "layer",
            "type": "string",
            "enum": [
              "layer",
              "context",
              "environment"
            ]
          },
          "parent": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
          },
          "rank": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "order": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "type": "string",
            "enum": [
              "microservice",
              "api-gateway",
              "frontend-web",
              "mobile-app",
              "database",
              "cache",
              "message-broker",
              "queue",
              "worker",
              "storage",
              "cdn",
              "load-balancer",
              "external-service",
              "actor",
              "generic"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "changed",
              "unchanged"
            ]
          },
          "tech": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              {
                "minItems": 1,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              }
            ]
          },
          "group": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "maxLength": 300
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^\\S+$"
          },
          "subtitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "badge": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "rank": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "order": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "label",
          "type",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "http",
              "grpc",
              "graphql",
              "websocket",
              "sql",
              "amqp",
              "kafka",
              "mqtt",
              "sqs",
              "redis",
              "s3",
              "smtp",
              "tcp",
              "webhook",
              "event",
              "other"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "changed",
              "unchanged"
            ]
          },
          "async": {
            "type": "boolean"
          },
          "bidirectional": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "from",
          "to",
          "protocol"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "title",
    "nodes"
  ],
  "additionalProperties": false
}
